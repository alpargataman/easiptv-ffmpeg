+/* A fragmented file written with empty_moov has a moov whose durations are
+ * zero: players that read them (and no mehd) see an unknown duration. Once
+ * the last fragment is out, write the real durations in place; the fields
+ * keep their size, so nothing moves, and a file whose writer dies before
+ * this point stays as before (zero = unknown). */
+static void mov_write_fragmented_durations(AVFormatContext *s)
+{
+    MOVMuxContext *mov = s->priv_data;
+    AVIOContext *pb = s->pb;
+    int64_t end = avio_tell(pb), longest = 0;
+
+    if (!(pb->seekable & AVIO_SEEKABLE_NORMAL))
+        return;
+    for (int i = 0; i < mov->nb_streams; i++) {
+        MOVTrack *track = &mov->tracks[i];
+        int64_t duration;
+        if (!track->timescale)
+            continue;
+        duration = av_rescale_rnd(calc_pts_duration(mov, track), mov->movie_timescale,
+                                  track->timescale, AV_ROUND_UP);
+        if (duration <= 0 || duration >= INT32_MAX)
+            continue;
+        longest = FFMAX(longest, duration);
+        if (track->tkhd_duration_pos > 0 && avio_seek(pb, track->tkhd_duration_pos, SEEK_SET) >= 0)
+            avio_wb32(pb, duration);
+    }
+    if (longest > 0 && mov->mvhd_duration_pos > 0 && avio_seek(pb, mov->mvhd_duration_pos, SEEK_SET) >= 0)
+        avio_wb32(pb, longest);
+    avio_seek(pb, end, SEEK_SET);
+}
+
