# Pinned inputs of the build. build-decoder.sh refuses to run if the
# submodules are not checked out at exactly these commits.

# EasIPTV Player release this build belongs to (git tag: app-<APP_VERSION>-<BUILD_NUMBER>).
APP_VERSION=1.5.0
BUILD_NUMBER=1

# androidx/media (Media3) — official decoder_ffmpeg extension.
MEDIA3_TAG=1.11.1
MEDIA3_COMMIT=8c6678b657ede1e7883fc164ef73ed483c7796c3

# FFmpeg — official release tag recommended by the decoder_ffmpeg README (6.0 line).
FFMPEG_TAG=n6.0.1
FFMPEG_COMMIT=c41ff724ede7da657762d61097e26fac296c53bf

# Toolchain. NDK r28+ links 64-bit libraries with 16 KB page alignment by default.
NDK_VERSION=28.2.13676358
CMAKE_VERSION=3.31.6

# Minimum Android API level of the native code (= EasIPTV Player minSdk).
ANDROID_API=29
ABIS="armeabi-v7a arm64-v8a x86 x86_64"

# Audio decoders only. All of them are LGPL-2.1+ in FFmpeg (no GPL, no nonfree).
DECODERS="aac mp3 ac3 eac3 dca mlp truehd flac alac pcm_mulaw pcm_alaw opus vorbis"
